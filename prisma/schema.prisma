generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  engineering_manager
  developer
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(developer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Sprint {
  id          String   @id @default(cuid())
  externalId  String?  @unique
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String
  snapshotAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IssueCache {
  id         String   @id @default(cuid())
  issueId    String   @unique
  source     String
  payload    Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DashboardSnapshot {
  id                String   @id @default(cuid())
  sprintId          String?
  totalIssues       Int
  completed         Int
  inProgress        Int
  blocked           Int
  inReview          Int
  staleIssues       Int
  sprintHealthScore Int
  payload           Json
  createdAt         DateTime @default(now())
}

model AIInsight {
  id         String   @id @default(cuid())
  scope      String
  referenceId String?
  model      String
  prompt     String
  response   Json
  createdAt  DateTime @default(now())
}
